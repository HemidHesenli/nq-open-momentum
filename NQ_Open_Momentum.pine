//@version=6
// NQ Open Momentum — bias pəncərəsi + H1 ATR stop, 2R hədəf, 15:59 vaxtla çıxış
// Qaydalar (NY vaxtı, default):
//   Bias pəncərəsi 09:30–10:15: 09:30 açılışı qeyd olunur
//   10:15: qiymət 09:30 açılışından yuxarıdırsa LONG, aşağıdadırsa SHORT (Follow)
//   Stop = 1.5 × ATR(14, SMA, 1H) — sonuncu bağlanmış saatlıq şamın dəyəri
//   Hədəf = 2 × stop, vurulmasa 15:59-da bağla, gündə 1 trade
// Qrafik: NQ1! / MNQ1!, 1–5 dəqiqəlik interval tövsiyə olunur
indicator("NQ Open Momentum (ATR)", "NQ-OM", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───── Ayarlar ─────
biasSess  = input.session("0930-1015", "Bias pəncərəsi (NY) — giriş pəncərənin sonunda", group = "Vaxt")
mode      = input.string("Follow", "İstiqamət", options = ["Follow", "Fade"], group = "Vaxt")
atrLen    = input.int(14, "ATR uzunluğu", minval = 1, group = "ATR")
atrSmooth = input.string("SMA", "ATR smoothing", options = ["SMA", "RMA", "EMA", "WMA"], group = "ATR")
atrTf     = input.timeframe("60", "ATR intervalı", group = "ATR")
atrMult   = input.float(1.5, "Stop = ATR ×", step = 0.25, group = "ATR")
rr        = input.float(2.0, "Hədəf (R)", step = 0.5, group = "Risk")
riskUsd   = input.float(100, "Trade başına risk ($)", minval = 1, group = "Risk")
showStats = input.bool(true, "Statistika cədvəli", group = "Görünüş")
showOpen  = input.bool(true, "Bias başlanğıc xətti", group = "Görünüş")
cLong     = input.color(color.lime, "Long", group = "Görünüş")
cShort    = input.color(color.red, "Short", group = "Görünüş")

TZ = "America/New_York"
OPEN_MIN  = int(str.tonumber(str.substring(biasSess, 0, 2))) * 60 + int(str.tonumber(str.substring(biasSess, 2, 4)))
ENTRY_MIN = int(str.tonumber(str.substring(biasSess, 5, 7))) * 60 + int(str.tonumber(str.substring(biasSess, 7, 9)))
entryTxt  = str.substring(biasSess, 5, 7) + ":" + str.substring(biasSess, 7, 9)
biasTxt   = str.substring(biasSess, 0, 2) + ":" + str.substring(biasSess, 2, 4) + "–" + entryTxt
EXIT_MIN  = 16 * 60        // 16:00-da bağlanan şam = 15:59 çıxış

// ───── H1 ATR: bağlanmış əvvəlki saatlıq şamın dəyəri (repaint etmir) ─────
f_atr(int len, string s) =>
    tr = ta.tr(true)
    aSma = ta.sma(tr, len)
    aRma = ta.rma(tr, len)
    aEma = ta.ema(tr, len)
    aWma = ta.wma(tr, len)
    s == "SMA" ? aSma : s == "RMA" ? aRma : s == "EMA" ? aEma : aWma

atrH = request.security(syminfo.tickerid, atrTf, f_atr(atrLen, atrSmooth)[1], lookahead = barmerge.lookahead_on)

// ───── Vaxt ─────
mins  = hour(time, TZ) * 60 + minute(time, TZ)
tfMin = timeframe.in_seconds() / 60.0
dayNo = dayofmonth(time, TZ)

// ───── Vəziyyət ─────
var int   lastDay  = -1
var float open930  = na
var int   open930Bar = na
var bool  tradedToday = false
var int   state    = 0      // 0 = trade yoxdur, 1 = açıq trade
var int   dir      = 0
var float entry    = na
var float sl       = na
var float tp       = na
var float stopPts  = na
var line  lEntry   = na
var line  lSl      = na
var line  lTp      = na
var string todayStatus = "Gözlənilir"

// statistika
var int   nTrades = 0
var int   nWins   = 0
var float sumR    = 0.0
var float peakR   = 0.0
var float maxDD   = 0.0
var int   lossStreak = 0
var int   maxLossStreak = 0

// ───── Yeni gün ─────
if dayNo != lastDay
    lastDay     := dayNo
    open930     := na
    tradedToday := false
    todayStatus := "Gözlənilir"

// ───── Bias pəncərəsinin açılışı ─────
if na(open930) and mins >= OPEN_MIN and mins < ENTRY_MIN
    open930    := open
    open930Bar := bar_index

// ───── Giriş (pəncərənin sonu) ─────
if not tradedToday and state == 0 and mins >= ENTRY_MIN and mins < ENTRY_MIN + 5 and not na(open930) and not na(atrH)
    tradedToday := true
    price = open
    d = (price > open930 ? 1 : price < open930 ? -1 : 0) * (mode == "Fade" ? -1 : 1)
    if showOpen and not na(open930Bar)
        line.new(open930Bar, open930, bar_index, open930, color = color.gray, style = line.style_dotted)
    if d == 0
        todayStatus := "Trade yoxdur (qiymət = bias açılışı)"
    else
        dir     := d
        entry   := price
        stopPts := math.round_to_mintick(atrH * atrMult)
        sl      := entry - dir * stopPts
        tp      := entry + dir * stopPts * rr
        state   := 1
        col = dir > 0 ? cLong : cShort
        lEntry := line.new(bar_index, entry, bar_index, entry, color = col, width = 2)
        lSl    := line.new(bar_index, sl, bar_index, sl, color = cShort, style = line.style_dashed)
        lTp    := line.new(bar_index, tp, bar_index, tp, color = cLong, style = line.style_dashed)
        mnq = math.floor(riskUsd / (stopPts * 2))
        nq  = math.floor(riskUsd / (stopPts * 20))
        sizeTxt = "MNQ: " + str.tostring(mnq) + "  |  NQ: " + str.tostring(nq) + (mnq < 1 ? "  ⚠ risk çox kiçikdir" : "")
        txt = (dir > 0 ? "LONG" : "SHORT") + " @ " + str.tostring(entry, format.mintick) + "\nATR " + str.tostring(stopPts, format.mintick) + " pt\nSL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick) + "\n" + sizeTxt
        label.new(bar_index, dir > 0 ? low : high, txt, style = dir > 0 ? label.style_label_up : label.style_label_down, color = color.new(col, 20), textcolor = color.black, size = size.small)
        todayStatus := (dir > 0 ? "LONG" : "SHORT") + " aktiv — SL " + str.tostring(sl, format.mintick) + " / TP " + str.tostring(tp, format.mintick)
        alert(syminfo.ticker + " " + entryTxt + " " + (dir > 0 ? "LONG" : "SHORT") + " @ " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | ATR " + str.tostring(stopPts, format.mintick) + " | " + sizeTxt, alert.freq_once_per_bar)

// ───── Trade idarəsi (eyni şamda həm SL, həm TP olarsa — SL sayılır) ─────
if state == 1
    lEntry.set_x2(bar_index)
    lSl.set_x2(bar_index)
    lTp.set_x2(bar_index)
    hitSl = dir > 0 ? low <= sl : high >= sl
    hitTp = dir > 0 ? high >= tp : low <= tp
    endOfDay = mins + tfMin >= EXIT_MIN
    if hitSl or hitTp or endOfDay
        r = hitSl ? -1.0 : hitTp ? rr : dir * (close - entry) / stopPts
        how = hitSl ? "SL" : hitTp ? "TP" : "15:59"
        exitPx = hitSl ? sl : hitTp ? tp : close
        state := 0
        nTrades += 1
        nWins   += r > 0 ? 1 : 0
        sumR    += r
        peakR   := math.max(peakR, sumR)
        maxDD   := math.max(maxDD, peakR - sumR)
        lossStreak    := r < 0 ? lossStreak + 1 : 0
        maxLossStreak := math.max(maxLossStreak, lossStreak)
        rTxt = (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"
        label.new(bar_index, exitPx, how + " " + rTxt, style = label.style_label_left, color = color.new(r >= 0 ? cLong : cShort, 30), textcolor = color.black, size = size.small)
        todayStatus := "Bitdi: " + how + " " + rTxt
        alert(syminfo.ticker + " " + entryTxt + " trade bağlandı: " + how + " " + rTxt + " @ " + str.tostring(exitPx, format.mintick), alert.freq_once_per_bar)

// ───── Cədvəl ─────
var table t = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 25), border_width = 1)
if showStats and barstate.islast
    tc = color.white
    t.cell(0, 0, "Bias " + biasTxt + " " + mode, text_color = tc, text_size = size.small)
    t.cell(1, 0, "ATR(" + str.tostring(atrLen) + ", " + atrSmooth + ", " + atrTf + ") × " + str.tostring(atrMult) + " | " + str.tostring(rr) + "R", text_color = color.gray, text_size = size.small)
    t.cell(0, 1, "Bugün", text_color = tc, text_size = size.small)
    t.cell(1, 1, todayStatus, text_color = state == 1 ? (dir > 0 ? cLong : cShort) : tc, text_size = size.small)
    t.cell(0, 2, "Cari H1 ATR", text_color = tc, text_size = size.small)
    t.cell(1, 2, na(atrH) ? "—" : str.tostring(atrH * atrMult, format.mintick) + " pt  →  MNQ: " + str.tostring(math.floor(riskUsd / (atrH * atrMult * 2))), text_color = tc, text_size = size.small)
    t.cell(0, 3, "Trade sayı", text_color = tc, text_size = size.small)
    t.cell(1, 3, str.tostring(nTrades) + " (qrafikdəki tarix)", text_color = tc, text_size = size.small)
    t.cell(0, 4, "Win rate", text_color = tc, text_size = size.small)
    t.cell(1, 4, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#.0") + "%" : "—", text_color = tc, text_size = size.small)
    t.cell(0, 5, "Cəmi / orta", text_color = tc, text_size = size.small)
    t.cell(1, 5, nTrades > 0 ? str.tostring(sumR, "+#.#;-#.#") + "R  /  " + str.tostring(sumR / nTrades, "+#.###;-#.###") + "R" : "—", text_color = sumR >= 0 ? cLong : cShort, text_size = size.small)
    t.cell(0, 6, "Max DD / zərər seriyası", text_color = tc, text_size = size.small)
    t.cell(1, 6, str.tostring(maxDD, "#.#") + "R  /  " + str.tostring(maxLossStreak), text_color = tc, text_size = size.small)
    if timeframe.in_seconds() > 1800 or not timeframe.isintraday
        t.cell(0, 7, "⚠", text_color = color.orange, text_size = size.small)
        t.cell(1, 7, "Qrafiki 1–5 dəqiqəlik intervala keçir", text_color = color.orange, text_size = size.small)
    t.cell(0, 8, "Qeyd", text_color = color.gray, text_size = size.small)
    t.cell(1, 8, "Xərclər daxil deyil, eyni şamda SL+TP → SL", text_color = color.gray, text_size = size.small)
